      {"description": "Find nginx processes", "inputs": {"filter": "nginx"}}
    ]
  },
  {
    "op_id": "check_zombie_processes",
    "name": "Check zombie processes",
    "description": "Find zombie processes and show PID/PPID/state/command",
    "input_schema": {},
    "generators": [
      {
        "name": "ps_zombies_awk",
        "tool": "ps",
        "template": "ps -eo pid,ppid,state,cmd | awk '$3 ~ /Z/ {print}'",
        "when": []
      },
      {
        "name": "ps_zombies_grep",
        "tool": "ps",
        "template": "ps -eo pid,ppid,state,cmd | grep ' Z '",
        "when": []
      }
    ],
    "examples": [
      {"description": "Check for zombie processes", "inputs": {}}
    ]
  },
