  {
    "op_id": "manage_file_permissions",
    "name": "Manage file permissions",
    "description": "Change file permissions and ownership",
    "input_schema": {
      "path": {"type": "string"},
      "mode": {"type": "string", "optional": true},
      "owner": {"type": "string", "optional": true},
