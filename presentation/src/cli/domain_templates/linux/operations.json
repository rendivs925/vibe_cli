      {"name": "chown_both", "tool": "chown", "template": "chown {{owner}}:{{group}} {{path}}", "when": [{"name": "owner"}, {"name": "group"}]},
      {"name": "chgrp_group", "tool": "chgrp", "template": "chgrp {{group}} {{path}}", "when": [{"name": "group"}]}
    ],
    "examples": [
